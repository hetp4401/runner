{
  "name": "runner-control-cloudflare-test",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "FleetCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FleetCoordinator"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONFIG",
      "database_name": "runner-config-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "SCHEDULER": "cloudflare",
    "DOMAIN": "sim.example",
    "CONTROL_HOST": "localhost",
    "ACCOUNT_ID": "test-account",
    "ZONE": "test-zone",
    "POOLS": "{}",
    "MAC_TOKEN": "test-mac",
    "JOIN_TOKEN": "test-node",
    "ADMIN_PASSWORD": "test-admin",
    "STATE_SIGNING_KEY": "test-signing-key",
    "CONFIG_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
    "DNS": "off",
    "CF_API_BASE": "http://127.0.0.1:8790",
    "RECOVERY_MS": "1500",
    "FAILBACK_MS": "250",
    "LEASE_MS": "2000",
    "TICK_MS": "250",
    "EXECUTION_TIMEOUT_MS": "1500",
    "QUIET_MS": "0"
  }
}
