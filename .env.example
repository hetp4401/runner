# Your active Cloudflare DNS zone (apex domain, without https://).
DOMAIN=example.com
# Account: Cloudflare Tunnel Edit; Zone: DNS Edit and Zone Read.
CF_API_TOKEN=replace-with-your-scoped-api-token
# Alternatively, remove CF_API_TOKEN and set both:
# CF_API_EMAIL=you@example.com
# CF_API_KEY=your-global-api-key

# Defaults to runners.<DOMAIN>. This DNS name must be available.
# CONTROL_HOST=runners.example.com
# ACCOUNT_ID and ZONE are discovered automatically; set both to skip Zone Read.
# ACCOUNT_ID=
# ZONE=

# Init generates these once in /data/identity.json if not supplied here.
# ADMIN_PASSWORD=
# JOIN_TOKEN=
# STATE_SIGNING_KEY=

# New fleets require the admin password to deploy; existing app passwords can
# delegate updates. Set 0 only if intentionally offering public deployments.
REQUIRE_DEPLOY_AUTH=1
# Dashboard, app source and status are public. Secrets and logs require credentials.

# To use an existing reverse proxy/tunnel instead of the bundled cloudflared:
# AUTO_TUNNEL=0
# PUBLIC_URL=https://runners.example.com
# CONTROL_PORT=8920
# For migration of an older fleet, preserve its existing tunnel prefix:
# TUNNEL_PREFIX=runner
